{
  "name": "repoaudit",
  "version": "2.0.0",
  "description": "Score any Git repo for open-source readiness — docs, license, security, CI, packaging, community — then fix gaps in one command.",
  "bin": {
    "repoaudit": "bin/repoaudit.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/cli.ts",
    "start": "node bin/repoaudit.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "audit:self": "node bin/repoaudit.js . --no-color",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "repository",
    "audit",
    "score",
    "open-source",
    "checklist",
    "security",
    "readme",
    "license",
    "ci",
    "github-actions",
    "devtools",
    "repo-hygiene"
  ],
  "author": "Reza Karimzadeh <https://github.com/Rezakarimzadeh98>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rezakarimzadeh98/repoaudit.git"
  },
  "bugs": {
    "url": "https://github.com/Rezakarimzadeh98/repoaudit/issues"
  },
  "homepage": "https://github.com/Rezakarimzadeh98/repoaudit#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
